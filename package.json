{
  "name": "rspack-coverage-monorepo",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter rspack-coverage dev",
    "build": "pnpm --recursive --if-present build",
    "build:lib": "pnpm --filter rspack-coverage build:lib",
    "build:ui": "pnpm --filter rspack-coverage build:ui",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "test:watch": "pnpm --filter rspack-coverage test:watch",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "verify": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7"
  }
}
